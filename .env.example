# Required for real runs (tests run offline without any of these)
OPENAI_API_KEY=
TAVILY_API_KEY=

# LangSmith tracing (https://smith.langchain.com, free developer tier)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deep-research
# Regional endpoint: omit for US. EU: https://eu.api.smith.langchain.com
# GCP APAC: https://apac.api.smith.langchain.com   AWS US: https://aws.api.smith.langchain.com
# LANGSMITH_ENDPOINT=

# Optional overrides (defaults in src/deep_research/config.py)
# FAST_MODEL=gpt-6-luna
# STRONG_MODEL=gpt-6-sol
# QDRANT_URL=            # set to use Qdrant Cloud instead of local embedded mode
